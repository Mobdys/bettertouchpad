{
	"schemaVersion": 1,
	"id": "bettertouchpad",
	"version": "${version}",
	"name": "BetterTouchpad",
	"description": "Better Touchpad controls, gestures and customizable mappings for Minecraft!",
	"authors": [
		"TOPKAPI"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "MIT",
	"icon": "assets/bettertouchpad/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.BetterTouchpad"
		],
		"client": [
			"com.example.client.BetterTouchpadClient"
		]
	},
	"mixins": [
		"bettertouchpad.mixins.json",
		{
			"config": "bettertouchpad.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
